{
  "ai": {
    "provider": "anthropic",
    "model": "claude-haiku-5-5",
    "api_key_env": "ANTHROPIC_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 0,
    "languages": [
      "en"
    ],
    "analysis_concurrency": 3,
    "enrichment_concurrency": 3
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 7.0,
        "topic_dedup": true
      },
      "tech-blog": {
        "threshold": 4.0,
        "topic_dedup": false
      }
    }
  },
  "sources": {
    "github": [
      {
        "type": "repo_releases",
        "owner": "golang",
        "repo": "go",
        "enabled": true,
        "profile": "tech-news"
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 150,
      "profile": "tech-news"
    },
    "rss": [
      {
        "name": "Go Blog",
        "url": "https://go.dev/blog/feed.atom",
        "enabled": true,
        "category": "go",
        "profile": "tech-blog"
      },
      {
        "name": "Golang Weekly",
        "url": "https://golangweekly.com/rss/",
        "enabled": true,
        "category": "go",
        "profile": "tech-news"
      },
      {
        "name": "Lobsters: go/distributed/databases",
        "url": "https://lobste.rs/t/go,distributed,databases.rss",
        "enabled": true,
        "category": "backend",
        "profile": "tech-news"
      },
      {
        "name": "Martin Fowler",
        "url": "https://martinfowler.com/feed.atom",
        "enabled": true,
        "category": "architecture",
        "profile": "tech-blog"
      },
      {
        "name": "The Pragmatic Engineer",
        "url": "https://newsletter.pragmaticengineer.com/feed",
        "enabled": true,
        "category": "engineering",
        "profile": "tech-blog"
      },
      {
        "name": "Cloudflare Blog",
        "url": "https://blog.cloudflare.com/rss/",
        "enabled": true,
        "category": "backend",
        "profile": "tech-blog"
      },
      {
        "name": "Netflix Tech Blog",
        "url": "https://netflixtechblog.com/feed",
        "enabled": true,
        "category": "architecture",
        "profile": "tech-blog"
      }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "golang",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 50,
          "profile": "tech-news"
        },
        {
          "subreddit": "ExperiencedDevs",
          "enabled": true,
          "sort": "top",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 100,
          "profile": "tech-news"
        },
        {
          "subreddit": "programming",
          "enabled": true,
          "sort": "top",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 200,
          "profile": "tech-news"
        }
      ],
      "users": [],
      "fetch_comments": 5
    }
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": null,
    "profile_order": [
      "tech-news",
      "tech-blog"
    ],
    "category_groups": {},
    "default_group": "other",
    "default_group_limit": null
  },
  "webhook": {
    "enabled": false,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary_and_items",
    "overview_position": "last",
    "platform": "feishu",
    "layout": "collapsible",
    "fallback_layout": "markdown",
    "languages": [
      "zh"
    ],
    "request_body": {
      "msg_type": "interactive",
      "card": {
        "schema": "2.0",
        "config": {
          "wide_screen_mode": true
        },
        "header": {
          "title": {
            "tag": "plain_text",
            "content": "#{message_title}"
          },
          "template": "blue"
        },
        "body": {
          "elements": [
            {
              "tag": "markdown",
              "content": "#{summary}"
            }
          ]
        }
      }
    },
    "headers": ""
  }
}
